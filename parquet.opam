# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Apache Parquet writer in OCaml, for OxCaml"
description:
  "Writes Apache Parquet files with no Arrow or C++ dependency. The Thrift compact protocol, PLAIN encoding, page headers, statistics and the file footer are implemented in OCaml; zstd compression goes through libzstd. Columns are described with typed combinators over a row type, rows are buffered column by column with statistics, and a direct per-column API appends values without allocating. Requires the OxCaml compiler (unboxed floats) and the Jane Street libraries from its opam repository."
maintainer: ["hello@winterchill.xyz"]
authors: ["WinterChill AI"]
license: "MIT"
tags: ["parquet" "columnar" "storage" "oxcaml"]
homepage: "https://github.com/winterchill-trading/parquet"
doc: "https://github.com/winterchill-trading/parquet#readme"
bug-reports: "https://github.com/winterchill-trading/parquet/issues"
depends: [
  "ocaml" {>= "5.2.0"}
  "dune" {>= "3.17"}
  "core" {>= "v0.18~preview"}
  "ppx_jane" {>= "v0.18~preview"}
  "zstd" {>= "0.4"}
  "core_unix" {with-test & >= "v0.18~preview"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/winterchill-trading/parquet.git"
